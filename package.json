{
  "name": "azf",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json -w && tsc-alias -p tsconfig.build.json",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f azf"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.x",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.5.2",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.4.15",
    "tsc-alias": "^1.9.8",
    "typescript": "^5.0.0"
  },
  "main": "dist/{index.js,functions/*.js}"
}
